# Copie para .env na raiz do projeto (gitignore já ignora .env).
# Credenciais do PostgreSQL do docker-compose.yml (só para desenvolvimento local).
DATABASE_URL=postgres://pratocheio:pratocheio@127.0.0.1:5432/pratocheio

# Porta 5432 ocupada (ex.: PostgreSQL instalado no Windows)? Descomente e use a mesma porta
# nas três URLs: POSTGRES_PORTA (lida pelo docker compose), DATABASE_URL e TEST_DATABASE_URL.
# POSTGRES_PORTA=5433

# Opcional: banco usado por `npm test` (padrão abaixo, criado pelo docker compose).
# Os testes apagam os dados a cada caso — nunca aponte para o banco de desenvolvimento.
# TEST_DATABASE_URL=postgres://pratocheio:pratocheio@127.0.0.1:5432/pratocheio_test
